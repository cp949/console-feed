{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "tabWidth": 2,
  "printWidth": 80,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "**/lib/**",
    "**/.turbo/**",
    "_works/**",
    ".worktrees/**",
    "pnpm-lock.yaml"
  ]
}
