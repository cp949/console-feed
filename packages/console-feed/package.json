{
  "name": "@cp949/console-feed",
  "version": "3.7.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./component": {
      "types": "./dist/Component/index.d.ts",
      "import": "./dist/Component/index.mjs",
      "require": "./dist/Component/index.js"
    },
    "./hook": {
      "types": "./dist/Hook/index.d.ts",
      "import": "./dist/Hook/index.mjs",
      "require": "./dist/Hook/index.js"
    },
    "./unhook": {
      "types": "./dist/Unhook/index.d.ts",
      "import": "./dist/Unhook/index.mjs",
      "require": "./dist/Unhook/index.js"
    },
    "./transform": {
      "types": "./dist/Transform/index.d.ts",
      "import": "./dist/Transform/index.mjs",
      "require": "./dist/Transform/index.js"
    },
    "./package.json": "./package.json"
  },
  "description": "A React component that displays console logs from the current page, an iframe or transported across a server",
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.dts.json && node scripts/copy-dts.mjs",
    "test": "vitest run --reporter=verbose",
    "test:dist": "node scripts/verify-dist-shapes.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:compat": "bash scripts/test-react-compat.sh both",
    "test:react18": "bash scripts/test-react-compat.sh 18",
    "test:react19": "bash scripts/test-react-compat.sh 19",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist",
    "publish:dry-run": "npm pack --dry-run",
    "publish:npm": "npm publish --access public",
    "prepublishOnly": "pnpm build && pnpm test && pnpm test:dist"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "linkify-html": "^4.3.3",
    "linkify-react": "^4.3.3",
    "linkifyjs": "^4.3.3"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-inspector": "^9.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^4.1.11",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "devtools",
    "inspector",
    "object",
    "object-inspector",
    "react",
    "react-component",
    "reactjs",
    "table",
    "table-inspector",
    "table-view",
    "tableview",
    "tree",
    "tree-view",
    "treeview",
    "ui",
    "view"
  ],
  "homepage": "https://github.com/cp949/console-feed.git",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/console-feed.git",
    "directory": "packages/console-feed"
  },
  "bugs": {
    "url": "https://github.com/cp949/console-feed/issues"
  },
  "author": "jjfive",
  "license": "MIT"
}
