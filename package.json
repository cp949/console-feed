{
  "name": "console-feed-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint": "oxlint --max-warnings 0",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "clean": "./clean.sh",
    "release-it": "cd packages/console-feed && pnpm exec release-it",
    "publish": "cd packages/console-feed && pnpm publish:npm",
    "test:compat": "bash packages/console-feed/scripts/test-react-compat.sh both",
    "test:react18": "bash packages/console-feed/scripts/test-react-compat.sh 18",
    "test:react19": "bash packages/console-feed/scripts/test-react-compat.sh 19"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "release-it": "^21.1.1",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.27.1"
}
